		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
		<PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" Version="1.20.2" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\EyeCare.Application\EyeCare.Application.csproj" />
		<ProjectReference Include="..\EyeCare.Infrastructure\EyeCare.Infrastructure.csproj" />
	</ItemGroup>

</Project>