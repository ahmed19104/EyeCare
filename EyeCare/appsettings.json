{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "EyeCare_API_Identity",
    "Audience": "EyeCare_FrontEnd_Clients",
    "ExpiryInMinutes": 60
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "Billing": {
    "Refund": {
      "WindowDays": 30
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{RequestId}] [{UserId}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}